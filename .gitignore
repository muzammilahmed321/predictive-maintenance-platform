*.py[cod]
*$py.class

# Python build files
*.egg-info/
build/
dist/

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/


# ==========================================
# JUPYTER NOTEBOOKS
# ==========================================

# Keep .ipynb files
# Ignore only Jupyter's temporary checkpoint folders
.ipynb_checkpoints/


